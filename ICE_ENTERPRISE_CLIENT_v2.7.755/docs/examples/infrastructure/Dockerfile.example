# ICE v2.7.755: Reference Production Dockerfile
# This template demonstrates how to containerize the ICE Python Package (.whl).

FROM python:3.12-slim

WORKDIR /app

# 1. Install System Dependencies for Database Connectivity
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 2. Copy and Install the Proprietary ICE Python Package (Protected)
# Replace 'ice_engine-2.7.755-py3-none-any.whl' with your authorized binary.
COPY dist_wheel/ice_engine-2.7.755-py3-none-any.whl .
RUN pip install --default-timeout=1000 --no-cache-dir ice_engine-2.7.755-py3-none-any.whl

# 3. Environment Configuration (Enterprise Tunables)
# These should be overridden in your orchestration layer (K8s/Compose).
ENV ICE_MEMORY_CAP_GB=30.0
ENV ICE_WORKERS=4
ENV ICE_PORT=8000

# 4. Port Exposure
EXPOSE 8000

# 5. Production Entry Point
# The 'ice' command is provided by the installed package.
CMD ["ice", "run", "--host", "0.0.0.0", "--port", "8000"]

