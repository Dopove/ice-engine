      "id": "claim_a7f180ba25304a70879f52ac1f531032",
      "statement": "pytest_collection_modifyitems in tests/conftest.py determines Docker availability solely by probing localhost:5432 (Postgres) and localhost:6379 (Redis) with a 0.5s timeout, not any OTel collector port.",
      "evidence": [
        {
          "resource": "repo://tests/conftest.py#L14-L22",
          "version": "repo-lines-v1:sha256:45b904d4a353168d68a48ba4c0979393aac9960863e3ec9659d15ea523922807:"
        }
