# Copy to benchmarks/.env  (git-ignored) and fill in, or export these in CI.
# Nothing here is required for `--reader mock` offline runs.

# --- reader + judge model (any OpenAI-compatible endpoint) -------------------
# Option A: OpenCode Zen free tier (looser rate limits)
BENCH_LLM_BASE_URL=https://opencode.ai/zen/v1
BENCH_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BENCH_LLM_MODEL=ling-3.0-flash-fin-free
# Option B: OpenRouter free tier
#   BENCH_LLM_BASE_URL=https://openrouter.ai/api/v1
#   BENCH_LLM_MODEL=minimax/minimax-m3:free   (~50 calls/day on 0 credit)

# Hard stop after this many *new* API calls per calendar day (cache hits free).
BENCH_DAILY_CALL_BUDGET=200

# --- Mem0 comparison row (optional) -----------------------------------------
# Mem0's own extraction LLM runs locally so it never touches the budget above.
BENCH_MEM0_LLM_PROVIDER=ollama
BENCH_MEM0_OLLAMA_URL=http://localhost:11434
BENCH_MEM0_LLM_MODEL=qwen2.5:7b
BENCH_MEM0_EMBED_MODEL=nomic-embed-text

# --- ICE substrate --------------------------------------------------------- #
# sandbox = in-process aiosqlite + numpy cosine (no Docker). production = real
# Postgres/pgvector via DATABASE_URL (see docker-compose.ci.yml).
ICE_MODE=sandbox
